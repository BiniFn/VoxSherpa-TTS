<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0B1120">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#131B2D"
        android:paddingHorizontal="8dp">

        <ImageView
            android:id="@+id/btn_close"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="11dp"
            android:src="@drawable/ic_close"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="#E2E8F0" />

        <TextView
            android:id="@+id/txt_pdf_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="6dp"
            android:textColor="#E2E8F0"
            android:textSize="15sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="PDF" />

        <ImageView
            android:id="@+id/btn_speak_page"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="9dp"
            android:src="@drawable/icon_record_voice"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="#1D61FF" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/pdf_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:max="100"
        android:progress="0"
        android:progressTint="#1D61FF"
        android:background="#1E293B" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="8dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp">

            <ImageView
                android:id="@+id/pdf_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:contentDescription="PDF page" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/txt_scanned_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_margin="16dp"
            android:background="#CC7C2D12"
            android:padding="12dp"
            android:textColor="#FED7AA"
            android:textSize="12sp"
            android:visibility="gone"
            android:text="This looks like a scanned PDF — the pages are images, so there is no text to read aloud or select." />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#131B2D"
        android:paddingHorizontal="10dp">

        <Button
            android:id="@+id/btn_prev"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:backgroundTint="#1E293B"
            android:textColor="#CBD5E1"
            android:textSize="12sp"
            android:text="‹ Prev" />

        <TextView
            android:id="@+id/txt_page"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="#64748B"
            android:textSize="12sp"
            android:singleLine="true"
            android:text="—" />

        <Button
            android:id="@+id/btn_next"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:backgroundTint="#1E293B"
            android:textColor="#CBD5E1"
            android:textSize="12sp"
            android:text="Next ›" />
    </LinearLayout>
</LinearLayout>
